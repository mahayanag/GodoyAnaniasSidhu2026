        <Param val="resp_trial = key_resp_trial.keys&amp;#10;&amp;#10;# Caso sem resposta&amp;#10;if resp_trial is None:&amp;#10;    this_trial_correct = False&amp;#10;else:&amp;#10;    this_trial_correct = (str(resp_trial).lower() == str(correct_answer_trial).lower())&amp;#10;&amp;#10;# Salva dados&amp;#10;thisExp.addData('participant_resp_trial', str(resp_trial))&amp;#10;thisExp.addData('this_trial_correct', this_trial_correct)" valType="extendedCode" updates="constant" name="End Routine"/>
        <Param val="False" valType="bool" updates="None" name="disabled"/>
